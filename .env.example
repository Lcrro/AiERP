# Remote Nexterp / ERPNext
NEXTERP_REMOTE_BASE_URL=https://nexterp.example.com
NEXTERP_REMOTE_API_KEY=replace-me
NEXTERP_REMOTE_API_SECRET=replace-me

# Local WSL ERPNext sandbox, served by the discovered bench on port 8001
NEXTERP_LOCAL_BASE_URL=http://localhost:8001
NEXTERP_LOCAL_API_KEY=replace-me
NEXTERP_LOCAL_API_SECRET=replace-me

# Optional when your Frappe site name differs from the URL hostname.
# Example: fac.localhost
NEXTERP_HOST_HEADER=

# Local PostgreSQL material catalog for Agent item search.
# Created by docker-compose.yml on host port 55433.
MATERIAL_CATALOG_DATABASE_URL=postgresql://nexterp_agent:nexterp_agent_dev@localhost:55433/nexterp_agent
