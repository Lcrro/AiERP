# Remote Nexterp / ERPNext
NEXTERP_REMOTE_BASE_URL=https://nexterp.example.com
NEXTERP_REMOTE_API_KEY=replace-me
NEXTERP_REMOTE_API_SECRET=replace-me

# Local WSL ERPNext sandbox, served by the discovered bench on port 8001
NEXTERP_LOCAL_BASE_URL=http://localhost:8001
NEXTERP_LOCAL_API_KEY=replace-me
NEXTERP_LOCAL_API_SECRET=replace-me

# Clean civil-company ERPNext sandbox site.
NEXTERP_CIVIL_BASE_URL=http://127.0.0.1:8002
NEXTERP_CIVIL_API_KEY=replace-me
NEXTERP_CIVIL_API_SECRET=replace-me
NEXTERP_CIVIL_HOST_HEADER=

# Optional when your Frappe site name differs from the URL hostname.
# Example: fac.localhost
NEXTERP_HOST_HEADER=

# Local PostgreSQL material catalog for Agent item search.
# Created by docker-compose.yml on host port 55433.
MATERIAL_CATALOG_DATABASE_URL=postgresql://nexterp_agent:nexterp_agent_dev@localhost:55433/nexterp_agent

# DeepSeek model trial for natural-language -> ToolCall orchestration.
# Do not commit real keys.
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=60

# OpenClaw progressive capability runtime. Real tokens belong in the mode-600
# ~/.config/nexterp/openclaw-nexterp.env file created by the installer.
NEXTERP_CAPABILITY_API_URL=http://127.0.0.1:8790
NEXTERP_CAPABILITY_API_PORT=8790
NEXTERP_CAPABILITY_API_TOKEN=replace-with-random-token
NEXTERP_OPENCLAW_DEV_SUBJECT=nexterp-local-owner
NEXTERP_CAPABILITY_ERP_PROFILE=CIVIL
