# Copy to ~/.config/nexterp/openclaw-nexterp.env and chmod 600.
# Never commit the real file.
DEEPSEEK_API_KEY=replace-me
OPENCLAW_GATEWAY_TOKEN=replace-with-random-token
NEXTERP_CAPABILITY_API_TOKEN=replace-with-another-random-token
NEXTERP_CAPABILITY_API_URL=http://127.0.0.1:8790
NEXTERP_OPENCLAW_DEV_SUBJECT=nexterp-local-owner
NEXTERP_CAPABILITY_ERP_PROFILE=CIVIL
